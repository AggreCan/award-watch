{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "award-watch",
  "main": "src/index.tsx",
  "compatibility_date": "2025-12-01",
  // Never publish under the account's workers.dev subdomain; the site lives on its own domain.
  "workers_dev": false,
  // The site's own domain and its www form, as custom domains on the zone.
  "routes": [
    { "pattern": "awardwatch.ca", "custom_domain": true },
    { "pattern": "www.awardwatch.ca", "custom_domain": true }
  ],
  // Per-address request caps, enforced inside the Worker (see src/limits.ts).
  // Static files under /data/ and /fonts/ never reach the Worker and are not
  // counted, apart from the Atom feeds (see "assets" below), which have a cap
  // of their own: one feed service polls many feeds from one address, and the
  // radar's 6- and 12-month window files, which count as pages. An edge
  // rule in the dashboard is the first line; these are the second, and they
  // protect D1 and the downloads.
  "ratelimits": [
    { "name": "PAGE_LIMIT", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
    { "name": "FORM_LIMIT", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEED_LIMIT", "namespace_id": "2005", "simple": { "limit": 600, "period": 60 } },
    // Accounts: posts of an address or a code to /account/sign-in and
    // /account/check, only while ACCOUNTS_ENABLED is "true" (src/account/).
    { "name": "AUTH_LIMIT", "namespace_id": "2006", "simple": { "limit": 5, "period": 60 } },
    // A delivery's stop link (/account/stop, GET and POST), only while
    // ACCOUNTS_ENABLED is "true": each request reads the accounts database,
    // and one-click posts arrive from mail providers' servers, many readers
    // to one address.
    { "name": "STOP_LIMIT", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } },
    // Stripe's webhook (/account/billing/webhook), only while ACCOUNTS_ENABLED
    // is "true". Stripe posts from a few addresses and retries a 429 later;
    // two a second each is far past this site's notices.
    { "name": "WEBHOOK_LIMIT", "namespace_id": "2008", "simple": { "limit": 120, "period": 60 } }
  ],
  // The daily check (src/watchdog.ts): 06:00 UTC, after the nightly run has had
  // its window and 2 h 15 after the same-day refresh's last cut. It emails the
  // operator through the email binding when the data, the backup, a stage, the
  // audience roll-up, a rolled-back deploy or the same-day refresh (its runs in
  // SEARCH, the live paid plans in ACCOUNTS) needs attention. ALERT_EMAIL is a
  // secret; the destination must be verified in the zone's Email Routing.
  // Saved-search deliveries (src/account/deliveries.ts): hourly from 15:00 to
  // 20:00 UTC, after the 12:30 UTC nightly; a run sends only once stats.json's
  // data date is today's, so the later hours cover a late nightly. While
  // ACCOUNTS_ENABLED is not "true" a run returns before reading anything.
  "triggers": { "crons": ["0 6 * * *", "0 15-20 * * *"] },
  // Aggregate counts of the responses the Worker serves (src/views.ts): route,
  // language, edge country, referring host, status, bot or human, device
  // class, and for a human a daily visitor code hashed under the secret
  // VIEWS_SALT_KEY (`npx wrangler secret put VIEWS_SALT_KEY`); never an
  // address, user agent or cookie. The dataset is created by the first write.
  "analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "awardwatch_views" }],
  "send_email": [
    { "name": "ALERTS" },
    // The accounts module's sender (src/account/sender.ts): sign-in messages
    // and saved-search deliveries go out from MAIL_FROM through Cloudflare
    // Email Sending, once the operator has onboarded awardwatch.ca for it
    // (that onboarding adds the SPF and DKIM records; docs/accounts.md). A
    // binding rather than a mail service's API, so there is no key to hold.
    // allowed_sender_addresses locks the binding to MAIL_FROM, so a mistake
    // cannot send as anyone else.
    { "name": "MAIL", "allowed_sender_addresses": ["alerts@awardwatch.ca"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Atom feeds go through the Worker first so their polls are counted
    // with the subscriber counts feed readers state (src/views.ts); the Worker
    // serves the file from the binding with its headers and a short cache.
    // The radar's 6- and 12-month windows go through it too: once the accounts
    // switch is on they are part of the paid plan, and a request without it
    // gets the site's 404 (src/pages/expiring.tsx, expiringFile); while the
    // switch is off the Worker passes each file on as it is. A path spelled
    // another way (an encoded character, a doubled slash) is redirected by
    // the static layer to its plain form, which these patterns then match.
    // The 12-month radar CSV follows the same rule (src/index.tsx). It comes
    // from R2 through the Worker already, since no static file has its path;
    // the entry keeps a copy ever published under public/ from serving it
    // past the gate.
    // Every other static file is still served before the Worker runs.
    "run_worker_first": ["/data/feeds/*", "/data/expiring/6m/*", "/data/expiring/12m/*", "/downloads/expiring-12m.csv"]
  },
  "d1_databases": [
    {
      // The forms database: organization_responses, corrections and interest
      // only (the "Visitor submissions" tables of pipeline/schema.sql).
      "binding": "DB",
      "database_name": "award-watch",
      // Replace with the id printed by `wrangler d1 create award-watch` on the project account.
      "database_id": "7248573a-8f5a-4c18-a2f3-5eaa5eb813f6"
    },
    {
      // The hosted search database: organizations and buyers by name, read by
      // /search with prepared statements only (src/search_db.ts). Written by
      // the nightly workflow's "Sync the search database" step alone, schema
      // in pipeline/search_schema.sql (docs/hosted-search.md). Its same-day
      // tables (pipeline/intraday_schema.sql, docs/intraday.md) are the
      // intraday workflow's, read by the paid band (src/intraday.ts) and the
      // daily check (intraday_runs).
      "binding": "SEARCH",
      "database_name": "awardwatch-search",
      "database_id": "bd8f5b25-a9d6-423a-88bf-301c9a313820"
    },
    {
      // Accounts (src/account/, docs/accounts.md): users, sign-in codes,
      // sessions, saved searches, API keys, entitlements and the audit trail,
      // apart from the forms database on purpose. Schema in
      // accounts_schema.sql, applied by hand. Pages read it only while
      // ACCOUNTS_ENABLED is "true". Two readers count its live pro
      // entitlements whatever the switch (LIVE_PRO_SQL in
      // src/account/entitlements.ts): the daily check, through this binding,
      // and the intraday workflow's gate, through the D1 REST API by the
      // database_id below (ACCOUNTS_DATABASE_ID there; a test holds the two
      // equal).
      "binding": "ACCOUNTS",
      "database_name": "awardwatch-accounts",
      "database_id": "c5e21d6e-fe3c-4a3a-8d82-96e809e273b1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "awardwatch-data"
    }
  ],
  // ALERT_FROM is the daily check's sender on the zone. RUN_LOG_URL and
  // SITE_URL are the two addresses its email links to; the run log's address
  // is set by the operator once the repository exists (empty leaves the line
  // out). ACCOUNTS_ENABLED is the accounts switch: "false" keeps every
  // /account route a 404 and every public page as it was (docs/accounts.md).
  // MAIL_FROM is the sender of the accounts' messages (sign-in codes and
  // saved-search deliveries) on the zone, sent through the MAIL binding. The
  // four payment variables (src/account/stripe.ts) stay empty until the
  // operator's Stripe account exists: the Stripe price ids for Pro monthly and
  // yearly, and the figures the billing page prints beside them in Canadian
  // dollars (digits, cents optional). Empty, the billing page says Pro is not
  // available yet. The two Stripe secrets are set with `wrangler secret put`,
  // never here (docs/accounts.md, Payments).
  "vars": {
    "ALERT_FROM": "alerts@awardwatch.ca",
    "RUN_LOG_URL": "https://github.com/AggreCan/award-watch/actions/workflows/nightly.yml",
    "SITE_URL": "https://awardwatch.ca",
    "ACCOUNTS_ENABLED": "false",
    "MAIL_FROM": "alerts@awardwatch.ca",
    "STRIPE_PRICE_MONTHLY": "price_1UXYgUIuriRWUbRJrdi3g2T0",
    "STRIPE_PRICE_YEARLY": "price_1UXYgUIuriRWUbRJt0429luJ",
    "PRICE_MONTHLY_CAD": "19",
    "PRICE_YEARLY_CAD": "190"
  },
  // Workers Logs keeps the console lines (which name events and counts, never
  // an address, a code or a token) and not the per-request invocation log,
  // which records each request's URL: the sign-in link's token and a
  // delivery's stop secret travel in a query string.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
