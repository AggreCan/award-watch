{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "award-watch",
  "main": "src/index.tsx",
  "compatibility_date": "2025-12-01",
  // Never publish under the account's workers.dev subdomain; the site lives on its own domain.
  "workers_dev": false,
  // The custom domains go here once the zone is on the account:
  // "routes": [
  //   { "pattern": "awardwatch.ca", "custom_domain": true },
  //   { "pattern": "www.awardwatch.ca", "custom_domain": true }
  // ],
  // Per-address request caps, enforced inside the Worker (see src/limits.ts).
  // Static files under /data/ and /fonts/ never reach the Worker and are not
  // counted, apart from the Atom feeds (see "assets" below), which have a cap
  // of their own: one feed service polls many feeds from one address. An edge
  // rule in the dashboard is the first line; these are the second, and they
  // protect D1 and the downloads.
  "ratelimits": [
    { "name": "PAGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "FORM_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEED_LIMIT", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } }
  ],
  // The daily check (src/watchdog.ts): 06:00 UTC, after the nightly run has had
  // its window. It emails the operator through the email binding when the data,
  // the backup, a stage, the audience roll-up or a rolled-back deploy needs
  // attention. ALERT_EMAIL is a secret; the destination must be verified in the
  // zone's Email Routing.
  "triggers": { "crons": ["0 6 * * *"] },
  // Aggregate counts of the responses the Worker serves (src/views.ts): route,
  // language, edge country, referring host, status, bot or human, device
  // class, and for a human a daily visitor code hashed under the secret
  // VIEWS_SALT_KEY (`npx wrangler secret put VIEWS_SALT_KEY`); never an
  // address, user agent or cookie. The dataset is created by the first write.
  "analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "awardwatch_views" }],
  "send_email": [{ "name": "ALERTS" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Atom feeds go through the Worker first so their polls are counted
    // with the subscriber counts feed readers state (src/views.ts); the Worker
    // serves the file from the binding with its headers and a short cache.
    // Every other static file is still served before the Worker runs.
    "run_worker_first": ["/data/feeds/*"]
  },
  "d1_databases": [
    {
      // The forms database: organization_responses and corrections only
      // (the "Visitor submissions" tables of pipeline/schema.sql).
      "binding": "DB",
      "database_name": "award-watch",
      // Replace with the id printed by `wrangler d1 create award-watch` on the project account.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "awardwatch-data"
    }
  ],
  // ALERT_FROM is the daily check's sender on the zone. RUN_LOG_URL and
  // SITE_URL are the two addresses its email links to; the run log's address
  // is set by the operator once the repository exists (empty leaves the line
  // out). Donations stay closed until DONATE_URL is added (see src/env.ts).
  "vars": {
    "ALERT_FROM": "alerts@awardwatch.ca",
    "RUN_LOG_URL": "",
    "SITE_URL": "https://awardwatch.ca"
  },
  "observability": {
    "enabled": true
  }
}
