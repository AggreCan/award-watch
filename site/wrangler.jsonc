{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "award-watch",
  "main": "src/index.tsx",
  "compatibility_date": "2025-12-01",
  // Never publish under the account's workers.dev subdomain; the site lives on its own domain.
  "workers_dev": false,
  // The site's own domain and its www form, as custom domains on the zone.
  "routes": [
    { "pattern": "awardwatch.ca", "custom_domain": true },
    { "pattern": "www.awardwatch.ca", "custom_domain": true }
  ],
  // Request caps, enforced inside the Worker (see src/limits.ts), each counted
  // per address unless its comment names another key.
  // Static files under /data/ and /fonts/ never reach the Worker and are not
  // counted, apart from the Atom feeds (see "assets" below), which have a cap
  // of their own: one feed service polls many feeds from one address, and the
  // radar's 6- and 12-month window files, which count as pages. An edge
  // rule in the dashboard is the first line; these are the second, and they
  // protect D1 and the downloads.
  "ratelimits": [
    { "name": "PAGE_LIMIT", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
    { "name": "FORM_LIMIT", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEED_LIMIT", "namespace_id": "2005", "simple": { "limit": 600, "period": 60 } },
    // Accounts: posts of an address or a code to /account/sign-in and
    // /account/check, only while ACCOUNTS_ENABLED is "true" (src/account/).
    // Ten a minute: a sign-in is two posts (the address, then the code), so
    // five people behind one office address can sign in within the same
    // minute. The codes an email address may ask for (five an hour) and its
    // wrong tries (five an hour, then the lock) are held in the accounts
    // database (src/account/signin.ts), whatever this figure.
    { "name": "AUTH_LIMIT", "namespace_id": "2006", "simple": { "limit": 10, "period": 60 } },
    // A delivery's stop link (/account/stop, GET and POST), only while
    // ACCOUNTS_ENABLED is "true": each request reads the accounts database,
    // and one-click posts arrive from mail providers' servers, many readers
    // to one address. A seat's invitation page (GET /account/seats/join),
    // a link from a message too, counts here while SEATS is "on".
    { "name": "STOP_LIMIT", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } },
    // Stripe's webhook (/account/billing/webhook), only while ACCOUNTS_ENABLED
    // is "true". Stripe posts from a few addresses and retries a 429 later;
    // two a second each is far past this site's notices.
    { "name": "WEBHOOK_LIMIT", "namespace_id": "2008", "simple": { "limit": 120, "period": 60 } },
    // The keyed API (/api/v1, src/api_keyed.ts), only while ACCOUNTS_ENABLED
    // is "true": requests per API key, keyed by the key's id, on top of the
    // per-address API_LIMIT above, so a key shared across many addresses is
    // still held to one rate. KEY_PER_MINUTE in src/api_keyed.ts is this
    // limit (a test holds the two equal).
    { "name": "KEY_LIMIT", "namespace_id": "2009", "simple": { "limit": 600, "period": 60 } },
    // A Pro account's calendar feed (/account/calendar/<id>.ics,
    // src/account/feeds.ts), only while ACCOUNTS_ENABLED is "true": each read
    // checks the feed in the accounts database. A calendar service reads a
    // subscribed feed every few hours, so this holds for thousands of feeds
    // read from one of its addresses. The Atom feeds keep FEED_LIMIT.
    { "name": "CALENDAR_LIMIT", "namespace_id": "2010", "simple": { "limit": 20, "period": 60 } },
    // An AI crawler (src/limits.ts AI_CRAWLERS), counted by the crawler's name
    // and not by address, since one asks from hundreds of addresses: ten
    // requests a minute for each crawler at each Cloudflare location, at most
    // 14,400 a day there, against the 270,000 a day one of them reached in
    // November 2026. Every request past it still runs the Worker for the 429,
    // so this bounds the work and tells the crawler to slow; public/robots.txt
    // asks the same of those that read it, and an edge rule in the dashboard
    // is what keeps a crawler that heeds neither from being counted at all.
    { "name": "CRAWLER_LIMIT", "namespace_id": "2011", "simple": { "limit": 10, "period": 60 } },
    // The dashboard's posts and the saved views' (/account/dashboard/panels
    // and /account/views, src/limits.ts "edit"), only while ACCOUNTS_ENABLED
    // is "true": each moves, adds or removes one row of the account's own, a
    // dashboard is rearranged one place a post, and FORM_LIMIT's 5 stays for
    // the posts that send mail or call the payment service (a seat's
    // invitation among them). Cancelling a seat's invitation, removing a
    // member and leaving a seat count here too, while SEATS is "on".
    { "name": "EDIT_LIMIT", "namespace_id": "2012", "simple": { "limit": 60, "period": 60 } },
    // A paying reader's downloads (src/limits.ts, the "download" bucket),
    // only while ACCOUNTS_ENABLED is "true": a download whose session is
    // signed in on Pro or Ultra counts here, keyed by the account's user id,
    // in place of DOWNLOAD_LIMIT's count by address, which every other
    // request keeps. One buyer's analytics view offers 8 tables as CSV, so 30
    // a minute takes three buyers' tables and most of a fourth. The limiter
    // shares the request's one session read (src/account/session.ts
    // readSession); a request without a session cookie reads nothing for it,
    // and one whose session the database cannot answer is counted by address.
    { "name": "PAID_DOWNLOAD_LIMIT", "namespace_id": "2013", "simple": { "limit": 30, "period": 60 } }
  ],
  // The daily check (src/watchdog.ts): 06:00 UTC, after the nightly run has had
  // its window and 2 h 15 after the same-day refresh's last cut. It emails the
  // operator through the email binding when the data, the backup, a stage, the
  // audience roll-up, a rolled-back deploy or the same-day refresh (its runs in
  // SEARCH, the live paid plans in ACCOUNTS) needs attention. ALERT_EMAIL is a
  // secret; the destination must be verified in the zone's Email Routing.
  // Saved-search deliveries (src/account/deliveries.ts): hourly from 15:00 to
  // 20:00 UTC, after the 12:30 UTC nightly; a run sends only once stats.json's
  // data date is today's, so the later hours cover a late nightly. While
  // ACCOUNTS_ENABLED is not "true" a run returns before reading anything.
  // The nightly's three slots (12:30, 16:30, 20:30 UTC) and the same-day
  // job's nine (45 past 1, 3 and every odd hour from 11 to 23 UTC), the times
  // the two workflows schedule: at each the Worker starts the workflow
  // through GitHub's API with the secret WORKFLOW_RUN (src/dispatch.ts;
  // docs/site-deploy.md, "What starts the runs"), and GitHub's own schedules
  // stay as the fallback. src/index.tsx routes each expression exactly, and
  // an expression it does not know runs nothing; each is a constant in the
  // code that a test holds to this line.
  "triggers": { "crons": ["0 6 * * *", "0 15-20 * * *", "30 12,16,20 * * *", "45 1,3,11,13,15,17,19,21,23 * * *"] },
  // Aggregate counts of the responses the Worker serves (src/views.ts): route,
  // language, edge country, referring host, status, bot or human, device
  // class, and for a human a daily visitor code hashed under the secret
  // VIEWS_SALT_KEY (`npx wrangler secret put VIEWS_SALT_KEY`); never an
  // address, user agent or cookie. The dataset is created by the first write.
  "analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "awardwatch_views" }],
  "send_email": [
    { "name": "ALERTS" },
    // The accounts module's sender (src/account/sender.ts): sign-in messages
    // and saved-search deliveries go out from MAIL_FROM through Cloudflare
    // Email Sending, once the operator has onboarded awardwatch.ca for it
    // (that onboarding adds the SPF and DKIM records; docs/accounts.md). A
    // binding rather than a mail service's API, so there is no key to hold.
    // allowed_sender_addresses locks the binding to MAIL_FROM, so a mistake
    // cannot send as anyone else.
    { "name": "MAIL", "allowed_sender_addresses": ["alerts@awardwatch.ca"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Atom feeds go through the Worker first so their polls are counted
    // with the subscriber counts feed readers state (src/views.ts); the Worker
    // serves the file from the binding with its headers and a short cache.
    // The radar's 6- and 12-month windows go through it too: once the accounts
    // switch is on they are part of the paid plan, and a request without it
    // gets the site's 404 (src/pages/expiring.tsx, expiringFile); while the
    // switch is off the Worker passes each file on as it is. A path spelled
    // another way (an encoded character, a doubled slash) is redirected by
    // the static layer to its plain form, which these patterns then match.
    // The 6- and 12-month radar CSVs follow the same rule (src/index.tsx).
    // They come from R2 through the Worker already, since no static file has
    // their paths; the entries keep a copy ever published under public/ from
    // serving one past the gate.
    // Every other static file is still served before the Worker runs.
    "run_worker_first": ["/data/feeds/*", "/data/expiring/6m/*", "/data/expiring/12m/*", "/downloads/expiring-6m.csv", "/downloads/expiring-12m.csv"]
  },
  "d1_databases": [
    {
      // The forms database: organization_responses, corrections and interest
      // only (the "Visitor submissions" tables of pipeline/schema.sql).
      "binding": "DB",
      "database_name": "award-watch",
      // Replace with the id printed by `wrangler d1 create award-watch` on the project account.
      "database_id": "7248573a-8f5a-4c18-a2f3-5eaa5eb813f6"
    },
    {
      // The hosted search database: organizations and buyers by name, read by
      // /search with prepared statements only (src/search_db.ts). Written by
      // the nightly workflow's "Sync the search database" step alone, schema
      // in pipeline/search_schema.sql (docs/hosted-search.md). Its same-day
      // tables (pipeline/intraday_schema.sql, docs/intraday.md) are the
      // intraday workflow's, read by the paid band (src/intraday.ts) and the
      // daily check (intraday_runs).
      "binding": "SEARCH",
      "database_name": "awardwatch-search",
      "database_id": "bd8f5b25-a9d6-423a-88bf-301c9a313820"
    },
    {
      // Accounts (src/account/, docs/accounts.md): users, sign-in codes,
      // sessions, saved searches, API keys, entitlements and the audit trail,
      // apart from the forms database on purpose. Schema in
      // accounts_schema.sql, applied by hand. Pages read it only while
      // ACCOUNTS_ENABLED is "true". Two readers count its live pro
      // entitlements whatever the switch (LIVE_PRO_SQL in
      // src/account/entitlements.ts): the daily check, through this binding,
      // and the intraday workflow's gate, through the D1 REST API by the
      // database_id below (ACCOUNTS_DATABASE_ID there; a test holds the two
      // equal).
      "binding": "ACCOUNTS",
      "database_name": "awardwatch-accounts",
      "database_id": "c5e21d6e-fe3c-4a3a-8d82-96e809e273b1"
    },
    {
      // The records database: one row per counted record of the four money
      // sources, read by the analytics views and the organization, buyer and
      // segment deliveries with prepared statements only (src/records_db.ts,
      // src/account/records_deliveries.ts). Written by the nightly workflow's "Sync the
      // records database" step alone, schema in pipeline/records_schema.sql
      // (docs/analytics.md). Created 2026-11-04 with `wrangler d1 create
      // awardwatch-records` on the project account. While the id were the
      // placeholder zeros, the nightly step would send nothing and report
      // "no database".
      "binding": "RECORDS",
      "database_name": "awardwatch-records",
      "database_id": "b5db88f1-51e9-4dd5-bd48-b939315a56b7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "awardwatch-data"
    }
  ],
  // ALERT_FROM is the daily check's sender on the zone. RUN_LOG_URL and
  // SITE_URL are the two addresses its email links to; the run log's address
  // is set by the operator once the repository exists (empty leaves the line
  // out). ACCOUNTS_ENABLED is the accounts switch: "false" keeps every
  // /account route a 404 and every public page as it was (docs/accounts.md).
  // MAIL_FROM is the sender of the accounts' messages (sign-in codes and
  // saved-search deliveries) on the zone, sent through the MAIL binding. The
  // four payment variables (src/account/stripe.ts) stay empty until the
  // operator's Stripe account exists: the Stripe price ids for Pro monthly and
  // yearly, and the figures the billing page prints beside them in Canadian
  // dollars (digits, cents optional). Empty, the billing page says Pro is not
  // available yet. The two Stripe secrets are set with `wrangler secret put`,
  // never here (docs/accounts.md, Payments). The five Ultra variables are the
  // same for the plan above Pro: its Stripe product id, its monthly and
  // yearly price ids and their two figures. Nothing offers Ultra until all
  // five are set and the entitlement_tiers table is applied (docs/accounts.md,
  // Ultra). With all five set, Ultra is on sale from the moment the table is
  // on the accounts database; until then the two figures show its price on
  // the landing page's card, beside "Coming soon". FOLLOWS_PANEL is may
  // follow's switch (src/pages/follows.tsx, docs/accounts.md "May follow"):
  // "on" shows a signed-in reader the earlier contracts an open notice may
  // follow, with the Methodology's paragraph and the Terms' clause; "off"
  // keeps the notice page, the Methodology and the Terms as they were (the
  // plan cards' row stays). It is "on" since the hand check of the
  // production matches of 2026-11-15 passed. MAIL_DAILY_QUOTA is the
  // account's Email Sending quota for a day as the dashboard shows it, and
  // MAIL_DAILY_RESERVE the part of it the delivery job leaves for sign-in
  // codes, which go through the same MAIL binding: the job stops for the UTC
  // day once its sends reach the quota less the reserve (src/env.ts
  // mailCeiling, src/account/deliveries.ts). Raise MAIL_DAILY_QUOTA when
  // Cloudflare raises the quota (it was 200 until Cloudflare raised it to
  // 1,000 on 2026-11-20); empty, there is no ceiling. BUILDER_DEMO is
  // the landing page's band on the analytics builder (src/pages/landing.tsx,
  // docs/landing.md "The builder's band"): "on", with ACCOUNTS_ENABLED
  // "true", shows it, drawn from National Defence's buyer file; anything else
  // keeps the landing page as it was. It stays "off" until the builder and
  // the new dashboard it shows are live. BUILDER is the analytics builder's
  // switch (src/pages/builder.tsx, docs/analytics.md "The builder"): "on",
  // with ACCOUNTS_ENABLED "true", serves /analytics/build and its CSV to
  // Ultra, links it from the analytics index and the rail and names it on
  // Ultra's plan card; anything else keeps both addresses the site's 404 and
  // every page as it was. It stays "off" until the operator has checked the
  // first night's cubes. WORKFLOW_REPO is the repository
  // whose nightly and same-day workflows the Worker's cron starts
  // (src/dispatch.ts); the token is the secret WORKFLOW_RUN, never a variable.
  // SEATS is the seats' switch (src/account/seats.ts seatsOn, docs/accounts.md
  // "Seats"): "on", with ACCOUNTS_ENABLED "true" and the seats table on the
  // accounts database, opens the Seats page, the invitations and their join
  // page; anything else keeps every address under /account/seats and
  // /account/seat the site's 404, sends no invitation and leaves every page
  // as it was. It stays "off" until the lawyer's read of the Terms' Seats
  // section and of the invitation.
  "vars": {
    "ALERT_FROM": "alerts@awardwatch.ca",
    "RUN_LOG_URL": "https://github.com/AggreCan/award-watch/actions/workflows/nightly.yml",
    "SITE_URL": "https://awardwatch.ca",
    "ACCOUNTS_ENABLED": "true",
    "MAIL_FROM": "alerts@awardwatch.ca",
    "MAIL_DAILY_QUOTA": "1000",
    "MAIL_DAILY_RESERVE": "40",
    "STRIPE_PRICE_MONTHLY": "price_1UXstXIP2lpoGRa5hXTTSm4A",
    "STRIPE_PRICE_YEARLY": "price_1UXstXIP2lpoGRa5H1NF6Od3",
    "PRICE_MONTHLY_CAD": "18.99",
    "PRICE_YEARLY_CAD": "189.99",
    "STRIPE_PRODUCT_ULTRA": "prod_Vc4vQ9HheohQoH",
    "STRIPE_PRICE_ULTRA_MONTHLY": "price_1UaqlrIP2lpoGRa5HcXsLV44",
    "STRIPE_PRICE_ULTRA_YEARLY": "price_1UaqmoIP2lpoGRa54JFX2voW",
    "PRICE_ULTRA_MONTHLY_CAD": "38.99",
    "PRICE_ULTRA_YEARLY_CAD": "389.99",
    "FOLLOWS_PANEL": "on",
    "BUILDER_DEMO": "off",
    "BUILDER": "off",
    "SEATS": "off",
    "WORKFLOW_REPO": "AggreCan/award-watch"
  },
  // Workers Logs keeps the console lines (which name events and counts, never
  // an address, a code or a token) and not the per-request invocation log,
  // which records each request's URL: the sign-in link's token and a
  // delivery's stop secret travel in a query string.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
